# =============================================================================
# SupplyTrace — Frontend Environment (.env.local)
# =============================================================================

# Optional: Dedicated Sepolia RPC URL (Infura/Alchemy). If omitted, falls back to public Sepolia RPC.
VITE_SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/your-api-key

# Optional: The Graph Studio query endpoint for full custody history on /verify/:tokenId
VITE_SUBGRAPH_URL=https://api.studio.thegraph.com/query/your-subgraph-id/supplytrace/version/latest
